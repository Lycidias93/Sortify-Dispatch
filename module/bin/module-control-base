#!/system/bin/sh
set -u
umask 077

BINDIR=${0%/*}
MODDIR=${MODULE_DIR:-${BINDIR%/bin}}
PROP="$MODDIR/module.prop"
MODULE_ID=sortify
MODULE_NAME=$(sed -n 's/^name=//p' "$PROP" 2>/dev/null | head -n 1)
MODULE_VERSION=$(sed -n 's/^version=//p' "$PROP" 2>/dev/null | head -n 1)
STATE_DIR=${MODULE_STATE_DIR:-/data/adb/sortify}
RUNTIME_DIR=${WEBUI_RUNTIME_DIR:-/data/local/tmp/sortify-webui}
CONFIG_FILE=${SORTIFY_CONFIG_FILE:-$STATE_DIR/sortify.conf}
DEFAULT_CONFIG="$MODDIR/config/sortify.conf.default"
LEGACY_CONFIG=/data/adb/modules/sortify/sortify.conf
DOMAIN="$BINDIR/sortify-domain"
LOCK_DIR="$RUNTIME_DIR/config.lock"
DEST_BASE=${DEST_BASE:-/sdcard/Sortify}

mkdir -p "$STATE_DIR" "$RUNTIME_DIR" "$STATE_DIR/backups" 2>/dev/null || true
chmod 0700 "$STATE_DIR" "$RUNTIME_DIR" "$STATE_DIR/backups" 2>/dev/null || true

json_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e ':a;N;$!ba;s/\n/\\n/g'
}
json_string() { printf '"%s"' "$(json_escape "$1")"; }

cfg_raw() {
  key=$1
  file=${2:-$CONFIG_FILE}
  sed -n "s/^${key}=//p" "$file" 2>/dev/null | tail -n 1
}

bool_value() {
  key=$1; fallback=$2; value=$(cfg_raw "$key")
  case "$value" in 0|1) printf '%s' "$value" ;; *) printf '%s' "$fallback" ;; esac
}

uint_value() {
  key=$1; fallback=$2; min=$3; max=$4; value=$(cfg_raw "$key")
  case "$value" in ""|*[!0-9]*) value=$fallback ;; esac
  [ "$value" -ge "$min" ] 2>/dev/null || value=$fallback
  [ "$value" -le "$max" ] 2>/dev/null || value=$max
  printf '%s' "$value"
}

enum_value() {
  key=$1; fallback=$2; allowed=$3; value=$(cfg_raw "$key")
  for item in $allowed; do [ "$value" = "$item" ] && { printf '%s' "$value"; return; }; done
  printf '%s' "$fallback"
}

prefixes_valid() {
  value=$1
  [ "${#value}" -le 4096 ] || return 1
  [ -z "$value" ] && return 0
  old_ifs=$IFS; IFS=,
  for raw in $value; do
    item=$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    case "$item" in ""|target-*|targets-*|*[!a-z0-9_.-]*) IFS=$old_ifs; return 1 ;; esac
    [ "${#item}" -ge 3 ] && [ "${#item}" -le 64 ] || { IFS=$old_ifs; return 1; }
  done
  IFS=$old_ifs
  return 0
}

prefixes_value() {
  value=$(cfg_raw SORTIFY_CUSTOM_PARK_PREFIXES)
  prefixes_valid "$value" && printf '%s' "$value" || printf ''
}

write_complete_config_from() {
  source=$1; out=$2
  source_value() { sed -n "s/^$1=//p" "$source" 2>/dev/null | tail -n 1; }
  pick() { value=$(source_value "$1"); [ -n "$value" ] && printf '%s' "$value" || printf '%s' "$2"; }
  {
    printf 'INTERVAL=%s\n' "$(pick INTERVAL 300)"
    printf 'GUARD_LOG=%s\n' "$(pick GUARD_LOG 1)"
    printf 'SORTIFY_NORMAL_SORT=%s\n' "$(pick SORTIFY_NORMAL_SORT 1)"
    printf 'SORTIFY_SORT_MODE=%s\n' "$(pick SORTIFY_SORT_MODE interval)"
    printf 'SORTIFY_HOLD_PROTECTED=%s\n' "$(pick SORTIFY_HOLD_PROTECTED 1)"
    printf 'SORTIFY_DISPATCHER_INTEGRATION=%s\n' "$(pick SORTIFY_DISPATCHER_INTEGRATION auto)"
    printf 'SORTIFY_CUSTOM_PARK_PREFIXES=%s\n' "$(source_value SORTIFY_CUSTOM_PARK_PREFIXES)"
    printf 'SORTIFY_GUARD_MAX_FILES=%s\n' "$(pick SORTIFY_GUARD_MAX_FILES 300)"
    printf 'SORTIFY_GUARD_STATUS_TIMEOUT=%s\n' "$(pick SORTIFY_GUARD_STATUS_TIMEOUT 8)"
    printf 'SORTIFY_DUPLICATE_MODE=%s\n' "$(pick SORTIFY_DUPLICATE_MODE filename)"
    printf 'SORTIFY_LOG_MAX_KB=%s\n' "$(pick SORTIFY_LOG_MAX_KB 1024)"
    printf 'SORTIFY_GUARD_TEMP_CLEAN_ON_SORT=%s\n' "$(pick SORTIFY_GUARD_TEMP_CLEAN_ON_SORT 1)"
    printf 'SORTIFY_PREVIEW_MAX_FILES=%s\n' "$(pick SORTIFY_PREVIEW_MAX_FILES 50)"
    printf 'SORTIFY_DISPATCHER_RUNTIME_DIR=/data/adb/ssh-drop-dispatcher\n'
    printf 'SORTIFY_DISPATCHER_REQUIRED_POLICY=v4115\n'
    printf 'SORTIFY_DISPATCHER_RELEASE_DIR=/data/adb/ssh-drop-dispatcher/integration/sortify-release\n'
  } > "$out"
}

initialize_config() {
  tmp="$CONFIG_FILE.tmp.$$"
  if [ -f "$CONFIG_FILE" ]; then
    write_complete_config_from "$CONFIG_FILE" "$tmp" || return 1
    if cmp -s "$CONFIG_FILE" "$tmp" 2>/dev/null; then
      rm -f "$tmp"
      chmod 0600 "$CONFIG_FILE" 2>/dev/null || true
      return 0
    fi
    stamp=$(date '+%Y%m%d_%H%M%S' 2>/dev/null || echo now)
    cp -f "$CONFIG_FILE" "$STATE_DIR/backups/sortify.conf.pre-normalize.$stamp" 2>/dev/null || true
    chmod 0600 "$tmp" 2>/dev/null || true
    mv -f "$tmp" "$CONFIG_FILE"
    return $?
  fi
  source=$DEFAULT_CONFIG
  [ -f "$LEGACY_CONFIG" ] && source=$LEGACY_CONFIG
  [ -f "$source" ] || return 1
  write_complete_config_from "$source" "$tmp" || return 1
  chmod 0600 "$tmp" 2>/dev/null || true
  mv -f "$tmp" "$CONFIG_FILE"
}

initialize_config || { echo '{"ok":false,"error":"Sortify config initialization failed"}' >&2; exit 1; }

request_file_allowed() {
  path=$1
  case "$path" in "$RUNTIME_DIR"/requests/*.json) ;; *) return 1 ;; esac
  [ -f "$path" ] || return 1
  [ ! -L "$path" ] || return 1
  size=$(wc -c < "$path" 2>/dev/null || echo 999999)
  case "$size" in ""|*[!0-9]*) return 1 ;; esac
  [ "$size" -ge 1 ] && [ "$size" -le 65536 ]
}

# Keep request parsing within portable POSIX BRE. Toybox sed does not guarantee
# GNU sed's \| alternation extension; extraction and validation are separate.
json_bool() { sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([a-z][a-z]*\).*/\1/p' "$2" | head -n 1; }
json_uint() { sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "$2" | head -n 1; }
json_text() { sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' "$2" | head -n 1; }

acquire_lock() {
  attempts=0
  while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    attempts=$((attempts + 1)); [ "$attempts" -lt 20 ] || return 1; sleep 0.1
  done
}
release_lock() { rmdir "$LOCK_DIR" 2>/dev/null || true; }

run_domain() {
  [ -x "$DOMAIN" ] || { echo "Sortify domain backend unavailable" >&2; return 69; }
  MODULE_DIR="$MODDIR" CONF_PATH="$CONFIG_FILE" sh "$DOMAIN" "$@"
}

config_json() {
  guard_log=$(bool_value GUARD_LOG 1); normal_sort=$(bool_value SORTIFY_NORMAL_SORT 1); hold=$(bool_value SORTIFY_HOLD_PROTECTED 1); temp_clean=$(bool_value SORTIFY_GUARD_TEMP_CLEAN_ON_SORT 1)
  [ "$guard_log" = 1 ] && guard_log=true || guard_log=false
  [ "$normal_sort" = 1 ] && normal_sort=true || normal_sort=false
  [ "$hold" = 1 ] && hold=true || hold=false
  [ "$temp_clean" = 1 ] && temp_clean=true || temp_clean=false
  printf '{"interval":%s,"guard_log":%s,"normal_sort":%s,"sort_mode":' "$(uint_value INTERVAL 300 30 86400)" "$guard_log" "$normal_sort"
  json_string "$(enum_value SORTIFY_SORT_MODE interval 'interval manual boot_once')"
  printf ',"hold_protected":%s,"dispatcher_integration":' "$hold"; json_string "$(enum_value SORTIFY_DISPATCHER_INTEGRATION auto 'off auto on')"
  printf ',"duplicate_mode":'; json_string "$(enum_value SORTIFY_DUPLICATE_MODE filename 'filename checksum_delete_identical')"
  printf ',"custom_park_prefixes":'; json_string "$(prefixes_value)"
  printf ',"guard_max_files":%s,"guard_timeout":%s,"log_max_kb":%s,"guard_temp_clean":%s,"preview_max_files":%s}' \
    "$(uint_value SORTIFY_GUARD_MAX_FILES 300 1 2000)" \
    "$(uint_value SORTIFY_GUARD_STATUS_TIMEOUT 8 2 60)" \
    "$(uint_value SORTIFY_LOG_MAX_KB 1024 64 16384)" "$temp_clean" \
    "$(uint_value SORTIFY_PREVIEW_MAX_FILES 50 1 200)"
}

