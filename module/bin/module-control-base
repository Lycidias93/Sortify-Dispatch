  printf '{"schema":"root-module-webui.capabilities.v1","module":{"id":"sortify","name":'; json_string "${MODULE_NAME:-Sortify Dispatch}"; printf ',"version":'; json_string "${MODULE_VERSION:-unknown}"; printf '},'
  printf '"features":{"config":true,"logs":true,"actions":true,"jobs":true,"inventory":true},"config_fields":['
  printf '{"key":"interval","label":"Sort interval","description":"Automatic interval in seconds. Used only in interval mode.","type":"integer","required":true,"min":30,"max":86400},'
  printf '{"key":"guard_log","label":"Guard logging","description":"Write bounded guard events.","type":"boolean","required":true},'
  printf '{"key":"normal_sort","label":"Normal sorting","description":"Allow normal Download sorting.","type":"boolean","required":true},'
  printf '{"key":"sort_mode","label":"Automatic sort mode","description":"Choose interval, manual or once per boot.","type":"enum","required":true,"options":[{"value":"interval","label":"Interval"},{"value":"manual","label":"Manual"},{"value":"boot_once","label":"Once per boot"}]},'
  printf '{"key":"hold_protected","label":"Hold protected artifacts","description":"Keep operational artifacts in Download until their safety contract allows release.","type":"boolean","required":true},'
  printf '{"key":"dispatcher_integration","label":"Dispatcher integration","description":"off ignores SDD markers, auto uses a healthy SDD link, on requires it.","type":"enum","required":true,"options":[{"value":"off","label":"Off"},{"value":"auto","label":"Auto"},{"value":"on","label":"Required"}]},'
  printf '{"key":"duplicate_mode","label":"Duplicate handling","description":"Checksum mode deletes only byte-identical sources after SHA-256 match.","type":"enum","required":true,"options":[{"value":"filename","label":"Filename only"},{"value":"checksum_delete_identical","label":"Checksum identical"}]},'
  printf '{"key":"custom_park_prefixes","label":"Custom park prefixes","description":"Comma-separated local-hold prefixes. target- and targets- are reserved for SDD.","type":"string","required":false,"max_length":4096,"pattern":"^[A-Za-z0-9_.-]*(,[A-Za-z0-9_.-]+)*$"},'
  printf '{"key":"guard_max_files","label":"Guard scan limit","description":"Maximum protected files inspected by bounded guard status.","type":"integer","required":true,"min":1,"max":2000},'
  printf '{"key":"guard_timeout","label":"Guard timeout","description":"Bounded guard status timeout in seconds.","type":"integer","required":true,"min":2,"max":60},'
  printf '{"key":"log_max_kb","label":"Log rotation size","description":"Rotate Sortify logs above this size in KiB.","type":"integer","required":true,"min":64,"max":16384},'
  printf '{"key":"guard_temp_clean","label":"Clean stale guard temp files","description":"Remove stale Sortify guard temp files before sorting.","type":"boolean","required":true},'
  printf '{"key":"preview_max_files","label":"Preview file limit","description":"Maximum files shown by Preview Sort.","type":"integer","required":true,"min":1,"max":200}'
  printf '],"actions":['
  printf '{"name":"sort-now","label":"Sort now","description":"Run one normal Sortify pass. Preview uses the existing read-only route logic.","risk":"caution","supports_dry_run":true},'
  printf '{"name":"guard-status","label":"Guard status","description":"Bounded read-only protected-artifact audit.","risk":"safe"},'
  printf '{"name":"guard-clean","label":"Restore misplaced protected artifacts","description":"Move misplaced protected artifacts back to Download; collisions go to GuardConflicts.","risk":"caution"},'
  printf '{"name":"guard-temp-clean","label":"Clean guard temp files","description":"Remove stale Sortify-owned temp files only.","risk":"caution"},'
  printf '{"name":"dispatcher-status","label":"Dispatcher link status","description":"Read-only SDD integration health and v4115 policy state.","risk":"safe"},'
  printf '{"name":"contract-smoke","label":"Contract smoke","description":"Run the read-only Sortify/SDD v4115 contract smoke.","risk":"safe"},'
  printf '{"name":"log-rotate","label":"Rotate logs","description":"Rotate bounded Sortify logs now.","risk":"safe"}'
  printf '],"jobs":['
  printf '{"name":"cleanup-scan","label":"Cleanup scan","description":"Read-only Download cleanup candidate scan.","risk":"safe"},'
  printf '{"name":"config-export","label":"Export Sortify config","description":"Create the existing Sortify-only configuration export in Download.","risk":"caution"}'
  printf '],"inventories":['
  printf '{"name":"guard","label":"Guard","description":"Current bounded protected-artifact status."},'
  printf '{"name":"dispatcher","label":"SDD link","description":"Read-only SDD v4115 integration state."},'
  printf '{"name":"cleanup","label":"Cleanup","description":"Download cleanup helper availability and safety state."}'
  printf ']}\n'
}

