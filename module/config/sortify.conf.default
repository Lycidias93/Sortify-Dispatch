INTERVAL=300
GUARD_LOG=1
SORTIFY_NORMAL_SORT=1
SORTIFY_SORT_MODE=interval
SORTIFY_HOLD_PROTECTED=1
SORTIFY_DISPATCHER_INTEGRATION=auto
SORTIFY_CUSTOM_PARK_PREFIXES=
SORTIFY_GUARD_MAX_FILES=300
SORTIFY_GUARD_STATUS_TIMEOUT=8
SORTIFY_DUPLICATE_MODE=filename
SORTIFY_LOG_MAX_KB=1024
SORTIFY_GUARD_TEMP_CLEAN_ON_SORT=1
SORTIFY_PREVIEW_MAX_FILES=50
SORTIFY_DISPATCHER_RUNTIME_DIR=/data/adb/ssh-drop-dispatcher
SORTIFY_DISPATCHER_REQUIRED_POLICY=v4115
SORTIFY_DISPATCHER_RELEASE_DIR=/data/adb/ssh-drop-dispatcher/integration/sortify-release
